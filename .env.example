# Synthetic tests do not require real credentials.

# Real-profile dry-runs are read-only and gated. Keep actual values in .env or your shell, never in git.
ALLOW_REAL_PROFILE_TESTS=false
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_IDS=
# Relative paths are resolved inside PRIVATE_TEST_DATA_DIR. file:// absolute paths are also supported.
MASKING_REGISTRY_URI=registry.json
MASKING_HMAC_SECRET=
PRIVATE_TEST_DATA_DIR=private-test-data

# Private dry-run layout, all ignored by git:
#   private-test-data/registry.json
#   private-test-data/profile-<profile_id>.json
# Each profile fixture must set fixture_kind=real_profile_read_only, profile_id=<profile_id>, and records=[...].

# Live execution tests stay disabled unless a separate approved execution adapter and allowlist exist.
ALLOW_LIVE_EXECUTION_TESTS=false
LIVE_EXECUTION_ALLOWLIST=
LIVE_EXECUTION_ADAPTER=
